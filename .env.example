# abl-demo runs fully offline by default (mock provider). These are only needed
# if you want real models to generate the agents' reasoning.
#   cp .env.example .env   # then export/source as you prefer

# Which provider speaks: mock (default) | anthropic | ollama
ABL_DEMO_PROVIDER=mock

# For ABL_DEMO_PROVIDER=anthropic
ANTHROPIC_API_KEY=

# For ABL_DEMO_PROVIDER=ollama (a local daemon at http://localhost:11434)
OLLAMA_MODEL=llama3
